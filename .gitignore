# Model weight checkpoints
# NOTE: Model checkpoints (.pt) are ignored due to file size.
# To track model weight files with Git LFS instead, run:
#   git lfs install
#   git lfs track "*.pt"
*.pt
*.onnx
*.engine
*.tflite
*.mlmodel

# Data directories (ignore all contents, preserve directory structure via .gitkeep)
data/raw/**/*
!data/raw/**/
!data/raw/**/.gitkeep

data/processed/**/*
!data/processed/**/
!data/processed/**/.gitkeep

data/dataset/**/*
!data/dataset/**/
!data/dataset/**/.gitkeep

# Outputs directory (ignore all contents, preserve directory structure via .gitkeep)
outputs/**/*
!outputs/**/
!outputs/**/.gitkeep

